{
  "name": "hub-central",
  "version": "0.7.0",
  "description": "HUB Central — plataforma parametrizável de centralização, orquestração e integração de serviços. Núcleo: Base Central de Contatos + Contrato de Módulos.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server.js",
    "create-admin": "node dist/cli/create-admin.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create -j sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "fast-check": "^3.23.2",
    "node-pg-migrate": "^9.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
