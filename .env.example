# Conexão do HUB Central com o PostgreSQL (núcleo)
# Copie para .env e ajuste conforme o ambiente.
DATABASE_URL=postgres://hub:hub@localhost:5432/hub_central

# node-pg-migrate usa a mesma URL
PGHOST=localhost
PGPORT=5432
PGUSER=hub
PGPASSWORD=hub
PGDATABASE=hub_central

# Anexos do módulo de Projetos Internos (armazenamento em disco local).
# Os limites efetivos (tamanho/tipos) são configuráveis na Central de
# Configurações do portal; estas variáveis servem de fallback inicial.
UPLOADS_DIR=./uploads
UPLOADS_MAX_BYTES=26214400
UPLOADS_ALLOWED=pdf,png,jpg,jpeg,gif,webp,txt,doc,docx,xls,xlsx,ppt,pptx,zip

# SMTP (envio de e-mails do sistema). Preferencialmente configure pela Central
# de Configurações do portal; estas variáveis servem de fallback inicial.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=nao-responda@seudominio.com
